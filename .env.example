# =============================================================================
# KITH — environment
#
# Copy to `.env.local` (git-ignored) and fill in.
#
# Everything is validated by Zod in src/lib/env/. A variable that is not in a
# schema there is not used by the application.
#
# For what each Supabase credential can do, and what happens if it ends up in
# the wrong place, see docs/SUPABASE.md.
# =============================================================================

# -----------------------------------------------------------------------------
# SITE
# -----------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. The origin baked into every email KITH sends —
# signup confirmation, password recovery, email change — and into metadataBase.
#
# The default below is for development only, and a production build now REFUSES
# to start with a loopback or plain-http value. That guard exists because the
# failure without it is invisible: the build succeeds, the site renders, and
# every new member is mailed a confirmation link pointing at localhost.
#
# It must also match, exactly, the Site URL configured in the Supabase dashboard
# (Authentication -> URL Configuration). See docs/DEPLOYMENT.md.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# SUPABASE
#
# Validated lazily, when a Supabase client is first constructed — the landing
# page has no database in it, so a fresh clone builds and runs without these.
# Anything that actually reaches for Supabase fails immediately and names the
# variable that is missing.
#
# Project Settings -> API in the Supabase dashboard.
# -----------------------------------------------------------------------------

# PUBLIC. Compiled into the browser bundle. Not a secret.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# PUBLIC BY DESIGN. Carries no privileges of its own — Row Level Security is
# what protects the data. Safe in the browser precisely because every table has
# a policy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ############################################################################
# # SECRET. BYPASSES ROW LEVEL SECURITY COMPLETELY.                          #
# #                                                                          #
# # Reads and writes every row for every user with no policy applied. Never   #
# # prefix it with NEXT_PUBLIC_, never import it into a client component.     #
# # Guarded by `import "server-only"` in src/lib/supabase/admin.ts, and the   #
# # env schema refuses to boot if this value is given to the anon variable.   #
# ############################################################################
SUPABASE_SERVICE_ROLE_KEY=""


# -----------------------------------------------------------------------------
# TURN / NAT traversal
#
# OPTIONAL, AND OFF BY DEFAULT. With none of this set, calls run on public STUN
# exactly as they did before TURN existed — a fresh clone builds, runs and makes
# calls without anybody signing up for a relay.
#
# What you lose without it: calls fail for a real share of network pairs, and
# not randomly. Symmetric NAT, carrier-grade NAT (most mobile networks), and
# corporate firewalls that drop UDP are the cases STUN cannot solve, and they
# are exactly the networks people are on when they most want to call.
#
# See docs/TURN.md for provider setup and how to verify it actually works.
# -----------------------------------------------------------------------------

# The relay URLs, comma-separated. Configure all three transports: UDP is the
# fast path, TCP survives networks that drop UDP, and TLS on 443 is
# indistinguishable from HTTPS to a firewall — which is the whole point of it.
#
#   TURN_URLS="turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp,turns:relay.example.com:5349?transport=tcp"
#
# The app warns at boot if the TLS entry is missing, because the symptom of
# leaving it out is "calls work for everybody except the person in the office".
# TURN_URLS=""

# ############################################################################
# # SECRET. AN OPEN BANDWIDTH RELAY IF IT LEAKS.                             #
# #                                                                          #
# # PREFERRED: the shared secret your TURN server is configured with          #
# # (coturn: `use-auth-secret` + `static-auth-secret`). The server mints a     #
# # short-lived credential per user per call and hands the browser that —     #
# # never this. Rotating it invalidates every outstanding credential at once. #
# #                                                                          #
# # Never prefix with NEXT_PUBLIC_. Guarded by `import "server-only"` in       #
# # src/lib/server/turn.ts, and `npm run check:bundle` fails the build if the #
# # value ever appears in client JavaScript.                                  #
# ############################################################################
# TURN_SHARED_SECRET=""

# How long a minted credential lasts. Ten minutes by default: longer than any
# call setup, short enough that a leaked one is worthless before anybody notices.
# TURN_CREDENTIAL_TTL_SECONDS="600"

# ALTERNATIVE, second-best: a static username and password, for providers that
# do not support the shared-secret scheme. Still never inlined into the bundle —
# delivered only to signed-in users who are on a call — but it does not expire,
# so rotating it means editing this variable. Use TURN_SHARED_SECRET instead
# wherever the provider allows it. Setting both means the secret wins.
# TURN_USERNAME=""
# TURN_PASSWORD=""


# =============================================================================
# TRANSACTIONAL EMAIL — REQUIRED IN PRODUCTION, AND NOT SET HERE
#
# These are NOT application environment variables. Supabase sends KITH's mail,
# so the SMTP credentials go in the Supabase dashboard (Project Settings ->
# Authentication -> SMTP Settings) and never into .env.local or Vercel. Listed
# here because "where do the SMTP settings go" is the question this file should
# answer, and the answer is "not here".
#
# Why it is required rather than nice to have: Supabase's built-in mailer is
# capped at a handful of messages an hour and is explicitly labelled for
# development only. Signup confirmation and password recovery are not optional
# features — without working mail, nobody can join and nobody can recover an
# account.
#
#   SMTP_HOST, SMTP_PORT (587), SMTP_USER, SMTP_PASSWORD
#   Sender: KITH <hello@your-domain>, from a domain with SPF and DKIM set up
#
# Verify by actually signing up and actually clicking the link. See
# docs/PRODUCTION-CHECKLIST.md.
# =============================================================================


# =============================================================================
# CI ONLY — NOT AN APPLICATION VARIABLE
# =============================================================================

# --- Migrations from CI -------------------------------------------------------
# ############################################################################
# # SECRET. MANAGES YOUR WHOLE SUPABASE ACCOUNT, NOT JUST THIS PROJECT.      #
# #                                                                          #
# # A GitHub Actions secret, used by `supabase db push`. Never in .env.local, #
# # never in Vercel — nothing the application runs ever needs it.            #
# ############################################################################
# SUPABASE_ACCESS_TOKEN=""

