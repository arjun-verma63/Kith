# =============================================================================
# KITH — environment
#
# Copy to `.env.local` (git-ignored) and fill in. The app runs with none of
# these set; every variable below either has a safe default or belongs to a
# phase that has not been built yet.
#
# Everything is validated by Zod at src/lib/env/. A variable that is not in a
# schema there is not used by the application.
# =============================================================================

# -----------------------------------------------------------------------------
# ACTIVE — validated by src/lib/env/schema.ts
# -----------------------------------------------------------------------------

# Canonical origin. Used for metadata, absolute URLs and (from Phase 2) the
# auth redirect allow-list. Must be the real origin in preview and production.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# =============================================================================
# NOT YET REQUIRED
#
# Listed so the shape of the finished system is visible and so nobody has to
# guess variable names later. They are deliberately absent from the Zod schemas
# until the phase that uses them lands — a variable that is validated but unused
# is just a way to make the app fail to boot for no reason.
# =============================================================================

# --- Phase 2: Supabase -------------------------------------------------------
# Public. Safe in the browser bundle; RLS is what protects the data.
# NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
#
# SECRET. Server only, bypasses RLS entirely. Never prefix with NEXT_PUBLIC_,
# never import into a client component. Guarded by `import "server-only"`.
# SUPABASE_SERVICE_ROLE_KEY=""

# --- Phase 2: transactional email -------------------------------------------
# Supabase's built-in SMTP is rate-limited and development-only. Verification
# and password-reset mail is core functionality, so custom SMTP is required
# before any real user is invited.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="KITH <hello@example.com>"

# --- Phase 7: WebRTC / NAT traversal ----------------------------------------
# STUN is free and public. TURN is not, and calls will fail for a meaningful
# share of network pairs without it. The shared secret mints short-lived
# per-call credentials server-side; it must never reach the browser.
# TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp"
# TURN_SHARED_SECRET=""
# TURN_CREDENTIAL_TTL_SECONDS="600"
