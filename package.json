{
  "name": "kith",
  "version": "0.1.0",
  "private": true,
  "description": "KITH \u2014 Your people. Your space. A private social space for a small group of friends.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:local": "node scripts/local-production.mjs build",
    "start:local": "node scripts/local-production.mjs start",
    "smoke": "node scripts/smoke.mjs",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "clean": "node -e \"for (const d of ['.next','node_modules/.cache']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:diff": "npx supabase db diff -f",
    "db:push": "npx supabase db push",
    "db:types": "node scripts/generate-database-types.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "db:types:check": "node scripts/check-database-types.mjs",
    "invite": "node scripts/invite.mjs",
    "mfa:reset": "node scripts/mfa-reset.mjs",
    "db:test": "node supabase/tests/rls.test.mjs",
    "auth:test": "node supabase/tests/auth.test.mjs",
    "auth-flows:test": "node supabase/tests/auth-flows.test.mjs",
    "mfa:test": "node supabase/tests/mfa.test.mjs",
    "account:test": "node supabase/tests/account.test.mjs",
    "safety:test": "node supabase/tests/safety.test.mjs",
    "settings:test": "node supabase/tests/settings.test.mjs",
    "mobile:test": "node supabase/tests/mobile.test.mjs",
    "pwa:test": "node supabase/tests/pwa.test.mjs",
    "perf:test": "node supabase/tests/perf.test.mjs",
    "security:test": "node supabase/tests/security.test.mjs",
    "deploy:test": "node supabase/tests/deploy.test.mjs",
    "profile:test": "node supabase/tests/profile.test.mjs",
    "friends:test": "node supabase/tests/friends.test.mjs",
    "presence:test": "node supabase/tests/presence.test.mjs",
    "messages:test": "node supabase/tests/messages.test.mjs",
    "typing:test": "node supabase/tests/typing.test.mjs",
    "notifications:test": "node supabase/tests/notifications.test.mjs",
    "calls:test": "node supabase/tests/calls.test.mjs",
    "call-session:test": "node supabase/tests/call-session.test.mjs",
    "screen-share:test": "node supabase/tests/screen-share.test.mjs",
    "call-media:test": "node supabase/tests/call-media.test.mjs",
    "turn:test": "node supabase/tests/turn.test.mjs",
    "games:test": "node supabase/tests/games.test.mjs",
    "wyr:test": "node supabase/tests/would-you-rather.test.mjs",
    "wkm:test": "node supabase/tests/who-knows-me.test.mjs",
    "draw:test": "node supabase/tests/draw-guess.test.mjs",
    "couple:test": "node supabase/tests/couple.test.mjs",
    "howwell:test": "node supabase/tests/how-well.test.mjs",
    "guess:test": "node supabase/tests/guess-my-answer.test.mjs",
    "webrtc:test": "node supabase/tests/webrtc.test.mjs",
    "test": "npm run db:test && npm run auth:test && npm run auth-flows:test && npm run mfa:test && npm run account:test && npm run safety:test && npm run settings:test && npm run mobile:test && npm run pwa:test && npm run perf:test && npm run security:test && npm run deploy:test && npm run profile:test && npm run friends:test && npm run presence:test && npm run messages:test && npm run typing:test && npm run notifications:test && npm run webrtc:test && npm run calls:test && npm run call-session:test && npm run screen-share:test && npm run call-media:test && npm run turn:test && npm run games:test && npm run wyr:test && npm run wkm:test && npm run draw:test && npm run couple:test && npm run howwell:test && npm run guess:test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "motion": "^13.1.1",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "node-datachannel": "^0.33.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
